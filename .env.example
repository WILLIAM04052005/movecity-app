PORT=3000
NODE_ENV=development

KIOSK_ID=1

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=movecity
DB_PASSWORD=*******
DB_NAME=movecity

# Authentification opérateur
JWT_SECRET=remplacez-par-une-longue-chaine-aleatoire-de-48-caracteres-minimum
JWT_EXPIRES_IN=2h
# Compte opérateur créé par "npm run db:seed" (laisser vide pour ne pas en créer)
ADMIN_EMAIL=operateur@movecity.local
ADMIN_PASSWORD=*************

# --- Synchronisation des ascenseurs (flux IDFM « État des ascenseurs ») ---
# Lancer à la main : npm run sync:ascenseurs    
# Automatique avec le serveur : IDFM_SYNC_ACTIVE=true (toutes les IDFM_SYNC_INTERVALLE_MIN minutes, min. 30)
# IDFM_SYNC_ACTIVE=false
# IDFM_SYNC_INTERVALLE_MIN=180
# Adresse du flux (à vérifier sur data.iledefrance-mobilites.fr, onglet « API »)
# IDFM_URL=https://data.iledefrance-mobilites.fr/api/explore/v2.1/catalog/datasets/etat-des-ascenseurs/records
# Secours hors-ligne : fichier CSV/JSON téléchargé à la main (prioritaire sur IDFM_URL)
# IDFM_FILE=./etat-des-ascenseurs.csv

# --- RGPD ---
# Durée de conservation du journal de statistiques (jours) — valider avec la Cyber
RETENTION_JOURNAL_JOURS=90

# --- Derrière un proxy / hébergeur (Render, Railway, Nginx…) : true ---
# TRUST_PROXY=false
