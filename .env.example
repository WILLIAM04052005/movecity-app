# --- Serveur ---
PORT=3000
NODE_ENV=development
# Identifiant de la borne servie par cette instance (table kiosque)
KIOSK_ID=1

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=movecity
DB_PASSWORD=movecity_dev
DB_NAME=movecity

# --- Authentification opérateur ---
JWT_SECRET=remplacez-par-une-longue-chaine-aleatoire-de-48-caracteres-minimum
JWT_EXPIRES_IN=2h
# Compte opérateur créé par "npm run db:seed"
ADMIN_EMAIL= remplacez-par-votre-adresse-mail
ADMIN_PASSWORD=**********

# --- Itinéraires ---
# Transports en commun : API « Calcul d'itinéraires » de PRIM)
PRIM_API_KEY= //////
# PRIM_URL=https://prim.iledefrance-mobilites.fr/marketplace/v2/navitia/journeys
# Marche / vélo / voiture : serveur de routage OpenStreetMap 
# ROUTAGE_URL=https://routing.openstreetmap.de
# LIMITE_ITINERAIRE_PAR_MINUTE=60

# --- RGPD ---
# Durée de conservation du journal de statistiques (jours) — valider avec la Cyber
RETENTION_JOURNAL_JOURS=90

# --- Derrière un proxy / hébergeur (Render, Railway, Nginx…) : true ---
# TRUST_PROXY=false
