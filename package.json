{
  "name": "movecity-kiosk",
  "version": "0.2.0",
  "description": "DataCity - Movecity - Borne interactive accessible (PMR, seniors, touristes) - Châtelet - Les Halles",
  "main": "server/src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "npm --prefix client install",
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/src/server.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "node server/src/server.js",
    "db:migrate": "node server/scripts/db.js migrate",
    "db:seed": "node server/scripts/db.js seed",
    "db:reset": "node server/scripts/db.js reset",
    "db:demo": "node server/scripts/db.js demo",
    "sync:ascenseurs": "node server/scripts/sync-ascenseurs.js",
    "operateur:creer": "node server/scripts/creer-operateur.js",
    "test": "npm --prefix client test",
    "test:api": "node --test --test-reporter=spec \"server/tests/*.test.js\"",
    "typecheck": "npm --prefix client run typecheck"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}